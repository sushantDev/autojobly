# Copy to .env and fill in. Never commit the real .env.

# Public URL Google and LinkedIn will send people back to.
# Local: http://127.0.0.1:8787
# Render sets RENDER_EXTERNAL_URL for you (https://autojobly.onrender.com).
# Only set this if you later buy a custom domain.
PUBLIC_BASE_URL=http://127.0.0.1:8787
APP_BASE_URL=http://127.0.0.1:8787
SESSION_SECRET=change-this-to-a-long-random-string

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URI: {PUBLIC_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn Developer Portal → Sign In with LinkedIn using OpenID Connect
# Authorized redirect URL: {PUBLIC_BASE_URL}/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
